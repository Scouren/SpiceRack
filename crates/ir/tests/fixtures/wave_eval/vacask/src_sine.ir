# The IR of vc-sources:tests/fixtures/dialect/vacask/settle/src_sine.sim, by the mapping of the
# VACASK reader's fixture read/sources/sine.ir (defaults sinedc 0, ampl 1, freq 1k, tdphase 0,
# theta 0, delay 0; `phase` is the AC phase only, `dc` dropped).
file "src_sine.sim" deck
  model vsource source_v
  element vsource v1 (a 0) model=vsource wave=sin(offset=1 amplitude=2 freq=1k delay=0 damping=0 phase_deg=0 pre=hold_delay_value) dc_rule=wave_at_zero
  element vsource v2 (b 0) model=vsource wave=sin(offset=1 amplitude=2 freq=1k delay=0.25m damping=0 phase_deg=90 pre=hold_delay_value) dc_rule=wave_at_zero
  element vsource v3 (c 0) model=vsource wave=sin(offset=0 amplitude=1 freq=1k delay=0 damping=0 phase_deg=0 pre=hold_delay_value) dc_rule=wave_at_zero
  element vsource v4 (d 0) model=vsource wave=sin(offset=1 amplitude=2 freq=1k delay=0.25m damping=1k phase_deg=0 pre=hold_delay_value) dc_rule=wave_at_zero
  element vsource v5 (e 0) model=vsource wave=sin(offset=1 amplitude=2 freq=1k delay=-0.25m damping=0 phase_deg=0 pre=hold_delay_value) dc_rule=wave_at_zero
