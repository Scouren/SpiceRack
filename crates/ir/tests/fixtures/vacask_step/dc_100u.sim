dc_100u: RC, dc=1, step=100u stop=1m, no maxstep
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
model rm sp_resistor
model cm sp_capacitor
model vsource vsource
v1 (1 0) vsource dc=1
r1 (1 2) rm r=1k
c1 (2 0) cm c=1n
control
  options rawfile="ascii"
  analysis tran1 tran step=100u stop=1m
endc
