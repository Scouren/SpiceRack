transit time factor 1 - ttt1*100 at 127 C, ttt1=-0.01... forward 0.6 V, AC current at 100 MHz
load "spice/diode.osdi"
load "spice/capacitor.osdi"
model vs vsource
model c sp_capacitor
model dm sp_diode is=1e-14 tt=1n ttt1=-0.01
v1 (a 0) vs dc=0.6 mag=1
d1 (a 0) dm
control
  options rawfile="ascii" reltol=1e-9
  options temp=127 tnom=27
  analysis ac1 ac from=100meg to=100meg mode="lin" points=1
endc
