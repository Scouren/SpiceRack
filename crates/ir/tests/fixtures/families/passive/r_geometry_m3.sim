passive r_geometry m3 (27 C, m=3), dc (1 V on a, 1 MHz)
load "spice/resistor.osdi"
model vs vsource
model rm sp_resistor rsh=100 narrow=0.1u short=0.2u tc1r=1e-3 tc2r=1e-5
vd (a 0) vs dc=1
r1 (a 0) rm l=10u w=2u $mfactor=3
control
  options temp=27 tnom=27 reltol=1e-9 abstol=1e-15 rawfile="ascii"
  analysis op1 op
endc
