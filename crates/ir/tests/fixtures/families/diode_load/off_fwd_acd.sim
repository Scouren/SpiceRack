diode_load off (80 C, m=3), fwd (vds=0.6), acd
load "spice/diode.osdi"
model vs vsource
model nm sp_diode is=1e-14 n=1.05 rs=5 bv=5 ibv=1e-6 ikf=10m cjo=1p vj=0.7 m=0.4 fc=0.5 tt=1n xti=3 eg=1.11 isr=1e-12 nr=2
vd (d 0) vs dc=0.6 mag=1
d1 (d 0) nm area=2 $mfactor=3
control
  options temp=80 tnom=27 reltol=1e-9 abstol=1e-15 rawfile="ascii"
  analysis ac1 ac from=1e9 to=1e9 mode="lin" points=1
endc
