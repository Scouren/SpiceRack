vdmos_load m3 (27 C, m=3), sat (vgs=3.0, vds=10.0), dc
load "spice/vdmos.osdi"
model vs vsource
model nm sp_vdmos type=1 vto=2 kp=20 lambda=0.01 rd=10m rs=10m rg=1 cgdmin=50p cgdmax=500p a=0.5 cgs=1n cjo=1n vj=0.8 m=0.4 fc=0.5 is=1e-12 n=1.2 tt=50n
vd (d 0) vs dc=10.0
vg (g 0) vs dc=3.0
m1 (d g 0 t tc) nm  $mfactor=3
control
  options temp=27 tnom=27 reltol=1e-9 abstol=1e-12 rawfile="ascii"
  analysis op1 op
endc
