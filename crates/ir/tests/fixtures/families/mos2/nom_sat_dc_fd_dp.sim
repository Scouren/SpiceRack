mos2 nom (27 C, m=1), sat (vgs=1.5, vds=3.0, vbs=-0.5), dc
load "spice/mos2.osdi"
model vs vsource
model nm sp_mos2 type=1 vto=0.7 kp=1e-4 gamma=0.5 phi=0.7 lambda=0.02 nsub=1e16 ucrit=1e4 uexp=0.1 vmax=5e4 neff=1 xj=0.5u nfs=1e11 delta=0.5 ld=0.1u tox=20n cgso=3e-10 cgdo=3e-10 cgbo=2e-10 cj=5e-4 mj=0.5 cjsw=2e-10 mjsw=0.33 pb=0.8 js=1e-4 fc=0.5 rd=10 rs=10
vd (d 0) vs dc=3.00001
vg (g 0) vs dc=1.5
vb (b 0) vs dc=-0.5
m1 (d g 0 b) nm w=10u l=2u ad=20p as=20p pd=24u ps=24u
control
  options temp=27 tnom=27 reltol=1e-9 abstol=1e-15 rawfile="ascii"
  analysis op1 op
endc
