bjt transient, 80 C, m=3, pulse 0..5 V on the gate through 10k, 2k load from 3 V
load "spice/bjt.osdi"
load "spice/resistor.osdi"
model vs vsource
model r sp_resistor
model nm sp_bjt type=1 ibe=1e-16 ibc=2e-16 bf=100 br=2 nf=1 nr=1 vaf=50 var=20 ikf=10m ikr=5m ise=1e-14 ne=1.5 isc=1e-14 nc=2 rb=50 rbm=10 irb=1m rc=5 re=1 cje=1p vje=0.75 mje=0.33 cjc=0.5p vjc=0.75 mjc=0.33 xcjc=0.8 cjs=0.3p vjs=0.7 mjs=0.5 tf=10p xtf=1 vtf=2 itf=10m tr=1n xtb=1.5 eg=1.11 xti=3 subs=1
vdd (dd 0) vs dc=3
rl (dd d) r r=2k
vin (in 0) vs type="pulse" val0=0 val1=5 delay=1n rise=1n fall=1n width=5n period=20n
rg (in g) r r=10k
vb (b 0) vs dc=-0.5
q1 (d g 0 b) nm area=2 $mfactor=3
control
  options temp=80 tnom=27 reltol=1e-6 abstol=1e-15 rawfile="ascii"
  analysis tran1 tran step=10p stop=40n maxstep=20p
endc
