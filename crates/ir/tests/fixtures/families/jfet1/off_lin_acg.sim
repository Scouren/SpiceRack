jfet1 off (80 C, m=3), lin (vgs=0.0, vds=0.2), acg
load "spice/jfet1.osdi"
model vs vsource
model nm sp_jfet1 type=1 vt0=-2 beta=1e-4 lambda=0.02 rd=10 rs=10 cgs=2p cgd=1p pb=0.8 is=1e-14 n=1 fc=0.5 b=0.9 tcv=2e-3 bex=-1.5 xti=3 eg=1.11
vd (d 0) vs dc=0.2
vg (g 0) vs dc=0.0 mag=1
j1 (d g 0) nm area=2 $mfactor=3
control
  options temp=80 tnom=27 reltol=1e-9 abstol=1e-15 rawfile="ascii"
  analysis ac1 ac from=1e9 to=1e9 mode="lin" points=1
endc
