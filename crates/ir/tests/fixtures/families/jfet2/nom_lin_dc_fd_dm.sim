jfet2 nom (27 C, m=1), lin (vgs=0.0, vds=0.2), dc
load "spice/jfet2.osdi"
model vs vsource
model nm sp_jfet2 type=1 vt0=-2 beta=1e-4 lambda=0.02 rd=10 rs=10 cgs=2p cgd=1p is=1e-14 n=1 fc=0.5 delta=0.1 xi=1000 p=2 q=2 z=1 vbi=1 hfeta=0.05
vd (d 0) vs dc=0.19999
vg (g 0) vs dc=0.0
j1 (d g 0) nm area=2
control
  options temp=27 tnom=27 reltol=1e-9 abstol=1e-15 rawfile="ascii"
  analysis op1 op
endc
