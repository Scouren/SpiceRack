latch: the same circuit, nested sweep (outer rin 10k, 10.1k; inner vin 2..5); VACASK v(c) outer 2: 4.9734 4.9788 4.9834 4.9876 4.9918 4.9959 5 (the outer step continues from the last point)
load "spice/mos1.osdi"
load "spice/resistor.osdi"
model vsource vsource
model resistor sp_resistor
model nm sp_mos1 type=1 vto=1 kp=1e-4
model pm sp_mos1 type=-1 vto=-1 kp=1e-4
vdd (vdd 0) vsource dc=5
vin (in 0) vsource dc=0
rin (in a) resistor r=10k
rf (c a) resistor r=20k
m1p (b a vdd vdd) pm w=10u l=1u
m1n (b a 0 0) nm w=10u l=1u
m2p (c b vdd vdd) pm w=10u l=1u
m2n (c b 0 0) nm w=10u l=1u
control
  options rawfile="ascii"
  sweep outer instance="rin" parameter="r" values=[10k, 10.1k]
    sweep inner instance="vin" parameter="dc" from=2 to=5 step=0.5
      analysis dc1 op
endc
