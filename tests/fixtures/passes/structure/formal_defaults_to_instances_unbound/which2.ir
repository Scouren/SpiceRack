file "a.sp" deck
  comment "R53 run which2 (ng-scaffold, ngspice-45): v(n1) = 3 at 1 mA, the instance's u = 3k; at the top, the top's 1k"
  param u = 1k
  subckt s (a b) t=u?
    element resistor r1 (a b) value=t
  subckt w (a b)
    param u = 3k
    element instance xs (a b) model=s
  element instance xw (n1 0) model=w
  element instance xt (n2 0) model=s
