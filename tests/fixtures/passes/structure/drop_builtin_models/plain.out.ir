file "a.sp" deck
  model resistor resistor
  element vsource v1 (a 0) dc=1
  element vsource v2 (b 0) dc=2
  element inductor l1 (a 0) value=1u
  element inductor l2 (b 0) value=1u
  element coupling k1 () inductors=(l1 l2) k=0.5
  element lossless_line t1 (a 0 b 0) z0=50 td=1n
  element resistor r1 (a 0) model=resistor value=1k
