cap ic under icmode uic, ic list
// settle (device_ic_to_tran_ic): VACASK: a 2.000000 at 0, 1.210039 at 0.5025m, 0.735760 at 1m
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
model res sp_resistor
model cap sp_capacitor
r1 (a 0) res r=1k

c1 (a 0) cap c=1u
control
  options rawfile="ascii"
  analysis tr tran stop=1m step=10u maxstep=10u icmode="uic" ic={"a", 2.0}
endc
