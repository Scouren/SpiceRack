differential ic with other entries: "a", "b", 2.0, "a", 5.0
// settle (device_ic_to_tran_ic): VACASK: a/b 5/3 at 0 (differential a-b=2 with a=5)
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
model res sp_resistor
model cap sp_capacitor
r1 (a 0) res r=1k
r2 (b 0) res r=2k
c1 (a b) cap c=1u
c2 (b 0) cap c=1u
control
  options rawfile="ascii"
  analysis tr tran stop=1m step=10u maxstep=10u icmode="uic" ic={"a", "b", 2.0, "a", 5.0}
endc
