file "a.sp" deck
  element resistor r1 (a 0) value=1k
  element resistor r2 (b 0) value=2k
  element capacitor c1 (a 0) value=1u
  element resistor r3 (c 0) value=1k
  element capacitor c2 (c b) value=1u
  analysis op
  nodeset ic transient next_only node=(a) value=2
  nodeset ic transient next_only node=(c) reference=(b) value=0.5
  analysis tran stop=3m print_step=10u max_step=10u uic
