SPICE BJT (Gummel-Poon): a common-emitter stage and a switching inverter, area 1

load "spice/bjt.osdi"
load "resistor.osdi"
load "capacitor.osdi"

model v vsource
model r resistor
model c capacitor

model qn sp_bjt type=1 is=1e-15 bf=100 br=2 vaf=50 ikf=10m rb=100 rc=10 re=1 cje=1p cjc=0.5p tf=0.3n tr=10n isc=1e-13 nc=1.5
model qp sp_bjt type=-1 is=1e-15 bf=50 br=1 vaf=40 rb=150 cje=1.5p cjc=0.8p tf=0.5n

vcc (vcc 0) v dc=5
vin (in 0) v type="pulse" val0=0 val1=5 delay=100n rise=10n fall=10n width=400n period=1u
rb1 (in b1) r r=10k
rc1 (vcc c1) r r=1k
q1 (c1 b1 0 0) qn
cl1 (c1 0) c c=1p

vb (bb 0) v type="sine" sinedc=0.7 ampl=5m freq=1meg
rb2 (bb b2) r r=1k
rc2 (vcc c2) r r=2k
q2 (c2 b2 0 0) qn $mfactor=2

rb3 (in b3) r r=10k
rc3 (0 c3) r r=1k
q3 (c3 b3 vcc vcc) qp

control
  analysis tran1 tran step=1n stop=2u maxstep=1n
endc
