written loops
control
  sweep s1 instance="x1:r1" parameter="r" from=1k to=2k step=500
    analysis t1 tran stop=1m
  sweep s2 option="temp" values=[0, 50]
  sweep s3 model="res" parameter="tc" from=0 to=1m mode="lin" points=2
    analysis a1 ac values=[1k]
  sweep s4 option="tran_rmax" from=1 to=100 mode="dec" points=2
    analysis t2 tran stop=1m
  mc m1 samples=3 seed=1
    analysis op1 op
  endmc
  mc m2 samples=2 lh=0
    sweep s5 option="reltol" values=[1e-3]
      analysis t3 tran stop=1m
  endmc
endc
