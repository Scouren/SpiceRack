# Oracle: VD expr-functions (each function's meaning); DIALECT-VACASK Appendix A runs e1, f1, f2
# (`round` half away, `integer` and `int` truncate, `sgn(0)` and `sgn(-0.0)` 1, `sign(3,-0.0)`
# 3). `sgn` is SgnZeroPos (typed as its operand: run f4), `sign` sugar over `>= 0` (R13). `int` is
# `to_int` (integer-typed), `integer` is `trunc` (real: run f2). A parameter's `atan2(y, x)` is
# `atan(y/x)`, less π when y < 0 and x < 0, plus π when y < 0 <= x (R76a, settle atan2,
# grid_static): written out over atan, the origin's axes taken apart (the IR divides by no zero).
# codes:
file "functions.sim" deck
  title "functions"
  param x = 1i
  param y = 2i
  param f1 = ln(x)
  param f2 = ln(x)
  param f3 = log10(x)
  param f4 = round_half_away(x)
  param f5 = trunc(x)
  param f6 = to_int(x)
  param f7 = pow(x, y)
  param f8 = min(x, y)
  param f9 = max(x, y)
  param f10 = fmod(x, y)
  param f11 = y < 0i ? (x >= 0i ? (x == 0i ? (y > 0i ? 1.5707963267948966 : y < 0i ? -(1.5707963267948966) : atan(y * 1 /: x)) : atan(y * 1 /: x)) + 3.141592653589793 : (x == 0i ? (y > 0i ? 1.5707963267948966 : y < 0i ? -(1.5707963267948966) : atan(y * 1 /: x)) : atan(y * 1 /: x)) - 3.141592653589793) : x == 0i ? (y > 0i ? 1.5707963267948966 : y < 0i ? -(1.5707963267948966) : atan(y * 1 /: x)) : atan(y * 1 /: x)
  param f12 = hypot(x, y)
  param f13 = abs(x)
  param f14 = sgn_zero_pos(x)
  param f15 = abs(x) * (y >= 0i ? 1i : -1i)
  param f16 = sqrt(x) + exp(x) + floor(x) + ceil(x) + sinh(x) + atanh(x)
