laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails
# Oracle: VD expr-vectors (vector values), expr-special (`$scale`), expr-functions (`isinf`):
# no IR node states them (DIALECT-VACASK §5 G13, G15); the statement is kept as text. An
# expression of `$temp` is dynamic (R14), whose functions are VACASK's behavioural set: `round`
# is not among them (VD dev-builtin-behavioral, Functions).
# codes: P2003 P2003 P2003 P2003 S0002 S0002 S0002 S0002
file "private_expr.sim" deck
  title "expressions with no IR meaning"
  opaque vacask private "parameters v=[1, 2]"
  opaque vacask private "parameters s=$scale*2"
  opaque vacask private "parameters t=isinf(1)"
  opaque vacask private "parameters r=round($temp)"
  param u = 3i
