# Oracle: VD cir-loading (`load` of `.osdi` or `.va`, `map=`), dev-spice (the shipped library
# files: a DeviceLibrary of its family, the default file stated by no path, A12 C5), input-embed (an
# embed a load names is the module's text: Private; one nothing names: Inert, C A20).
# codes: P2003 P2003 S0002 S0002 S0003
file "load_embed.sim" deck
  title "loads and embedded files"
  device_library resistor
  load osdi "mydev.osdi"
  load veriloga "nl2.va"
  opaque vacask private "load \"all.osdi\" map=[\"*\", \"lib_*\"]"
  opaque vacask private "embed \"nl2.va\" <<<FILE\nmodule nl2(a); inout a; endmodule\n>>>FILE"
  opaque vacask inert "embed \"plot.py\" <<<FILE\nprint(1)\n>>>FILE"
