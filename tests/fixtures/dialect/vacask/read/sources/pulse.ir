# Oracle: VD dev-builtin-src (Pulse: val0 0, val1 1, delay 0, rise 1n, fall 0, width 0,
# period 0) and runs p1 (fall=0: no falling edge, 1.0 at 3.5u), src-pulse (period 0 or below:
# one pulse; rise=1n by default: 0.5 at 0.5n). PulseLaw::Vacask, every field filled.
# codes:
file "pulse.sim" deck
  title "pulse"
  model vsource source_v
  model isource source_i
  element vsource v1 (a 0) model=vsource wave=pulse(v1=0 v2=1 delay=0 rise=1n fall=0 width=0 period=0 law=vacask) dc_rule=wave_at_zero
  element vsource v2 (b 0) model=vsource wave=pulse(v1=0i v2=1.8 delay=1u rise=1u fall=0i width=1u period=4u law=vacask) dc_rule=wave_at_zero
  element isource i1 (c 0) model=isource wave=pulse(v1=-1m v2=1m delay=0 rise=1n fall=2n width=5n period=20n law=vacask) dc_rule=wave_at_zero
