laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails default_temp_27 default_tnom_27 bsim4v45_small_signal_exact
# Oracle: R39, A20 (tline_ideal is a LosslessLine naming a model of the ideal-line family; its
# load a DeviceLibrary) and run t3 (a step into a matched 50 Ω line, the far end's arrival):
# td=2n 2.0 ns; f=100M 10 ns (nl 1); f=100M nl=0.5 5 ns; neither td nor f: nl/f with f's
# default 1 kHz and nl 1 (no arrival in 20 ns), so the reader fills f=1k nl=1; td and f both:
# td wins (2.0 ns), f dropped with the note P2206. z0 is 50 by default (run z0: `print
# instance` shows `z0 = 50 (not given)`). The load is the family's only file (tables.rs).
# codes: P2206
file "tline.sim" deck
  title "tline_ideal"
  device_library tline_ideal
  model tl tline_ideal
  element lossless_line t1 (a 0 b 0) model=tl z0=50i td=2n
  element lossless_line t2 (a 0 c 0) model=tl z0=50i freq=100meg nl=1
  element lossless_line t3 (a 0 d 0) model=tl z0=50i freq=100meg nl=0.5
  element lossless_line t4 (a 0 e 0) model=tl z0=50i freq=1k nl=1
  element lossless_line t5 (a 0 g 0) model=tl z0=50i td=2n
  element lossless_line t6 (a 0 h 0) model=tl mult=2i z0=50 td=1n
