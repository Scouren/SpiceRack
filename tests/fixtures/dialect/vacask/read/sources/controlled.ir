laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails
# Oracle: VD dev-builtin-vcvs, -vccs, -cccs, -ccvs (gain 1 by default; vcvs/vccs `p n cp cn`;
# cccs/ccvs `p n` and `ctlinst` the sensing instance, `ctlnode` "flow(br)" by default, the
# branch current) and run src-ctl (`print instance` of `f1 … ctlinst="v1" $mfactor=3`: gain 1,
# ctlnode "flow(br)").
# codes:
file "controlled.sim" deck
  title "controlled sources"
  model vsource source_v
  model e vcvs
  model g vccs
  model f cccs
  model h ccvs
  element vsource vp (a b) model=vsource dc=0i
  element vcvs e1 (o1 0 a 0) model=e gain=10i
  element vcvs e2 (o2 0 a 0) model=e gain=1
  element vccs g1 (o3 0 a b) model=g mult=2i gain=1m
  element cccs f1 (0 o4) model=f gain=3i sense=vp
  element ccvs h1 (o5 0) model=h gain=1k sense=vp
