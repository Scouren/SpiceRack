laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails default_temp_27 default_tnom_27 bsim4v45_small_signal_exact
# Oracle: R41 (a) and the lead's F11 ruling: a shipped module not proven its family's
# (families::PROVEN; psp103va has no pair deck) is read as
# a module model, so its file's load stays a plain load that defines nothing the IR drops
# (structure's drop_device_libraries); a proven one (sp_mos1, settle devices_semi) is the family
# on both rows.
# codes:
file "unproven_load.sim" deck
  title "an unproven shipped module and its file"
  load osdi "psp103v4.osdi"
  device_library mos1
  model nm module params=(toxo=2n) module=psp103va
  model n1 mos1 polarity=n params=(vto=1i)
  element module_model m1 (d g 0 0) model=nm params=(w=1u l=1u)
  element mosfet m2 (d g 0 0) model=n1 params=(w=1u l=1u)
