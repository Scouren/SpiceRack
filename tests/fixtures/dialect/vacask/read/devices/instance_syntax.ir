# Oracle: run dup ("An instance with name 'r1' already exists.": R2101, the first kept); run
# np ("Parser syntax error, unexpected identifier, expecting (": terminals in parentheses only,
# P2107); run rep (a parameter given twice: "Parameter first defined here.", P2108).
# codes: P2107 P2108 P2108 R2101 S0004 S0004 S0004 S0004
file "instance_syntax.sim" deck
  title "instance syntax"
  device_library resistor
  model res resistor
  element resistor r1 (a 0) model=res value=1k
  opaque vacask invalid "r1 (b 0) res r=2k"
  opaque vacask invalid "r2 a 0 res r=1k"
  opaque vacask invalid "r3 (a 0) res r=1k r=2k"
  opaque vacask invalid "model rr sp_resistor rsh=1 rsh=2"
