master scoping
load "spice/resistor.osdi"
r0 (a 0) late r=1k
model late sp_resistor
r9 (a 0) libres r=2k
subckt outer (p)
  model own sp_resistor
  r1 (p 0) own r=1k
  subckt inner (q)
    r2 (q 0) own r=1k
  ends
ends
subckt sub (a b)
  parameters g=1 $mfactor=1
  r1 (a b) late r=g
ends
x1 (n1 n2) sub g=2 $mfactor=3
x2 (n1 n2) sub h=2
x3 (n1) sub
x4 (n1 n2) nothing w=1
