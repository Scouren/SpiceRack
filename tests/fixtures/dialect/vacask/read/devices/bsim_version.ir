laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails default_temp_27 default_tnom_27 bsim4v45_small_signal_exact
# Oracle: A19 and F85, the pinned store's spice/bsim3v3.va (no `version` parameter: BSIM3v3.3.0)
# and spice/bsim4v8.va (`version = "4.8.3"`; 4.8.0 to 4.8.3 run as written, any other is "unknown
# BSIM4 version. Working now with BSIM4.8.3.", the gf180 cards' 4.5: ir-2's runs, d6632cda
# families/gf180_version/runs.out, up to 2.4 % off): a silent card states its module's version,
# a given one the module does not run is kept as text (P2111); the pair decks sp_bsim3v3_* and
# sp_bsim4v8_* prove the families.
# codes: P2111 S0002
file "bsim_version.sim" deck
  title "bsim versions"
  device_library bsim3
  device_library bsim4
  model n3 bsim3 polarity=n params=(vth0=0.6) version="3.3.0"
  model n4 bsim4 polarity=n params=(vth0=0.4) version="4.8.3"
  model n4b bsim4 polarity=n params=(vth0=0.4) version="4.8.2"
  opaque vacask private "model n45 sp_bsim4v8 type=1 version=\"4.5\" vth0=0.4"
