laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails default_temp_27 default_tnom_27 bsim4v45_small_signal_exact
# Oracle: settle diode_area_zero (run115: area=0 is area 1 with a warning to VACASK, no device to
# ngspice-45: kept as text, P2110; R91 F23). ikp, rsw, vp and qpscale are sp_diode's own: kept as
# given on the family (R91a), the ngspice writer refuses what its diode lacks.
# codes: P2110 P2110 S0002 S0002
file "diode_vacask_only.sim" deck
  title "diode parameters only VACASK has, and a zero area"
  device_library diode
  model da diode params=(is=1e-14)
  model dk diode params=(is=1e-14 ikp=1m)
  model dr diode params=(is=1e-14 rsw=1i)
  model dv diode params=(is=1e-14 vp=1i)
  model dq diode params=(is=1e-14 qpscale=2i)
  element diode d1 (a 0) model=da
  opaque vacask private "d2 (a 0) da area=0"
  opaque vacask private "d3 (a 0) da area=0.0"
  element diode d4 (a 0) model=dk
