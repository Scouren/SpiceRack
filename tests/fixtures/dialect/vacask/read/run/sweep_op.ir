laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails default_temp_27 default_tnom_27 bsim4v45_small_signal_exact
# Oracle: VD cmd-sweep (sweep + op is one result over the grid; the last sweep is the inner
# axis; the name names the swept vector; a sweep of a dc source's `dc` is its DC value, R64); A22 (DcAxis gains an optional name).
# codes:
file "sweep_op.sim" deck
  title "sweeps before an op"
  model vsource source_v
  element vsource v1 (a 0) model=vsource dc=1i
  element vsource v2 (b 0) model=vsource dc=1i
  analysis dc name=dc1 (source_dc v2) (list values=[0i, 1i]) name=vd (source_dc v1) (lin start=1i stop=3i step=0.5) name=vg
