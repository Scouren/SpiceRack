laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails default_temp_27 default_tnom_27 bsim4v45_small_signal_exact
# Oracle: VD cmd-options-tol, -temp, -tran, -op, -homotopy (the keys and their quantities);
# DIALECT-VACASK §3.4 options row; R24/A14 (VACASK's options hold from where they stand). An
# Env sets what it names (A14); `op_skipinitial=1` and a `tran_method` are flags.
# codes:
file "options.sim" deck
  title "typed options"
  option rel_tol value=1e-4
  option abs_tol value=1p
  option vn_tol value=1u
  option chg_tol value=1f
  option gmin value=1e-15
  option gshunt value=0i
  option scale value=1i
  env temp=50i tnom=25i
  option max_ord value=2i
  option itl1 value=200i
  option itl4 value=20i
  option gmin_steps value=10i
  option src_steps value=10i
  option no_op_iter
  option method_trap
  option method_euler
  env temp=27i
