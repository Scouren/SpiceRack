laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails
# Oracle: R70, A43; settle run/top_alter (VACASK re-elaborates after `alter
# instance("__topinst__") a=2.0`: op2 is -5e-3 A where op1 is -1e-2 A) and run/top_sweep: the
# top-level instance is the design, so its parameter is the IR's parameter target, bound to the
# top-level `a`.
# codes:
file "top_instance.sim" deck
  title "the top-level instance"
  model vsource source_v
  param a = 1.0
  element vsource v1 (in 0) model=vsource dc=10.0
  analysis op name=op1
  alter (param a) value=2.0
  analysis op name=op2
  analysis dc name=d1 (param a) (list values=[1i, 2i, 4i]) name=sa
  loop sweep name=sb (param a) (list values=[1i, 2i])
    analysis tran name=t1 stop=1u cap=span_over50
