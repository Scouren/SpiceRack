laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails default_temp_27 default_tnom_27 bsim4v45_small_signal_exact
# Oracle: VD cmd-alter (one or more names, each parameter set from the next analysis on;
# hierarchical names); run e2 (an alter persists); VD cmd-elaboration (`circuit("a", …)`
# promotes; `circuit` alone and `changes` are what happens anyway: Inert; topdef/topinst have no
# field: Private, P2311).
# codes: P2311 S0002 S0003 S0003
file "alter_elaborate.sim" deck
  title "alter and elaborate"
  device_library resistor
  model res resistor
  subckt s (p)
    element resistor r1 (p 0) model=res value=1k
  element instance x1 (n) model=s
  element resistor r1 (n 0) model=res value=1k
  element resistor r2 (n 0) model=res value=1k
  subckt a (p)
  subckt b (p)
  alter (element_value r1) value=2k
  alter (element_value r2) value=2k
  alter (element_value r1 path=(x1)) value=3k
  alter (model_param res tc) value=1m
  elaborate (a b)
  opaque vacask inert "elaborate circuit"
  opaque vacask inert "elaborate changes"
  opaque vacask private "elaborate circuit(\"a\") topdef=\"t\""
  analysis op name=op1
