# Oracle: VD cmd-analysis-mc (samples, seed default 0 = the simulator's own, lh default 1 =
# Latin hypercube, the statements between mc and endmc once per sample, nominal values restored
# after endmc); `debug` has no field (P2309: the loop, its body and its endmc Private).
# codes: P2309 S0002 S0002 S0002
file "mc.sim" deck
  title "monte carlo"
  loop monte_carlo name=m1 runs=3i seed=1i latin_hypercube
    analysis op name=op1
    loop sweep name=s1 (device_param r1 r) (list values=[1k, 2k])
      analysis tran name=t1 stop=1m cap=span_over50
  loop monte_carlo name=m2 runs=n
    analysis op name=op2
  opaque vacask private "mc m3 samples=2 debug=1"
  opaque vacask private "analysis op3 op"
  opaque vacask private "endmc"
