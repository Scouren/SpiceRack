alter and elaborate
load "spice/resistor.osdi"
model res sp_resistor
subckt s (p)
  r1 (p 0) res r=1k
ends
x1 (n) s
r1 (n 0) res r=1k
r2 (n 0) res r=1k
subckt a (p)
ends
subckt b (p)
ends
control
  alter instance("r1", "r2") r=2k
  alter instance("x1:r1") r=3k
  alter model("res") tc=1m
  elaborate circuit("a", "b")
  elaborate circuit
  elaborate changes
  elaborate circuit("a") topdef="t"
  analysis op1 op
endc
