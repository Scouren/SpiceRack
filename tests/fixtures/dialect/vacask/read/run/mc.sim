monte carlo
load "spice/resistor.osdi"
model res sp_resistor
subckt s (p)
  r1 (p 0) res r=1k
ends
x1 (n) s
r1 (n 0) res r=1k
r2 (n 0) res r=1k
control
  mc m1 samples=3 seed=1
    analysis op1 op
    sweep s1 instance="r1" parameter="r" values=[1k, 2k]
      analysis t1 tran stop=1m
  endmc
  mc m2 samples=n lh=0
    analysis op2 op
  endmc
  mc m3 samples=2 debug=1
    analysis op3 op
  endmc
endc
