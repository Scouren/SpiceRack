laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails
# Oracle: DIALECT-VACASK §3.4 (print, abort, postprocess: Inert, C K10); R43 (var Private under
# its own code, P2307); R63 (a statement reading a name only the Private var defines is Private
# under its own code, P2315: corpus demo/bsim3-ptm/characteristic.sim `op_itl=(a+b*a)*b`); VD cmd-options-set, cmd-save (`clear options`, `clear` reset state:
# Private, P2310); comments keep their place among the statements.
# codes: P2307 P2310 P2310 P2315 S0002 S0002 S0002 S0002 S0003 S0003 S0003
file "misc.sim" deck
  title "print, abort, postprocess, clear, var"
  comment " a comment before the first statement"
  opaque vacask private "var x=2"
  opaque vacask private "options op_itl=(x+1)*2 reltol=1e-4"
  opaque vacask inert "print instance(\"r1\")"
  opaque vacask inert "abort always"
  analysis op name=op1
  comment " between"
  comment "     analyses "
  analysis op name=op2
  opaque vacask inert "postprocess(PYTHON, \"x.py\")"
  opaque vacask private "clear options"
  opaque vacask private "clear"
