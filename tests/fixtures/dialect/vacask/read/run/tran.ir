laws bc_sat_areab_only sub_sat_emission_ns diode_wl_mult_once diode_sidewall_own_f1 diode_xom_absent_1e14 vdmos_kp_absent_20 vdmos_tcvth_raises vdmos_clamp_by_fc mos_small_signal_exact mos6_small_signal_exact bjt_irb_small_signal_exact vdmos_mult_charges_copies diode_isr_reverse_present diode_isr_small_signal_exact diode_tt_factor_clamped trig_exact exp_exact log_zero_error div_exact asin_edge_fails
# Oracle: VD cmd-analysis-tran (stop; step the initial step; start the start of recording;
# maxstep; icmode="uic"; ic list); run tr1 (no maxstep: the step is capped at (stop-start)/50,
# cap span_over50); run e7 (`maxstep=0` writes the same raw file as none: the rule, R47; a
# literal `start=0` records from 0: no record start); run e1
# (ic applies to that transient only; held in its operating point: transient).
# codes:
file "tran.sim" deck
  title "transients"
  analysis tran name=t1 stop=1m initial_step=1u cap=span_over50
  nodeset ic transient next_only node=(b) value=1i
  analysis tran name=t2 stop=10m record_start=6m initial_step=1u max_step=10u uic
  analysis tran name=t3 stop=1m cap=span_over50
