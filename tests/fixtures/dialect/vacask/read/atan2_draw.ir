# Oracle: settle atan2 and grid_static (VACASK 36be560): a parameter's atan2(1, -1) is
# atan(1/-1) = -0.785 (C's is 2.356), so the reader writes it out (R76a); an argument holding a
# draw would be drawn once per copy, so that statement is kept as text (P2015).
# codes: P2015 S0002
file "atan2_draw.sim" deck
  title "atan2 over a draw"
  opaque vacask private "parameters a=atan2(gauss(0,1,3), 1)"
  param b = 1i < 0i ? (-1i >= 0i ? (-1i == 0i ? (1i > 0i ? 1.5707963267948966 : 1i < 0i ? -(1.5707963267948966) : atan(1i * 1 /: -1i)) : atan(1i * 1 /: -1i)) + 3.141592653589793 : (-1i == 0i ? (1i > 0i ? 1.5707963267948966 : 1i < 0i ? -(1.5707963267948966) : atan(1i * 1 /: -1i)) : atan(1i * 1 /: -1i)) - 3.141592653589793) : -1i == 0i ? (1i > 0i ? 1.5707963267948966 : 1i < 0i ? -(1.5707963267948966) : atan(1i * 1 /: -1i)) : atan(1i * 1 /: -1i)
