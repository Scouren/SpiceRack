sp_resistor sp_capacitor sp_inductor against ngspice-45 R C L (R41 a); run prc
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
load "spice/inductor.osdi"
model is isource
model r sp_resistor
model c sp_capacitor
model l sp_inductor
i1 (0 n1) is dc=1m mag=1
r1 (n1 0) r r=1k tc1=0.01 tc2=0.001
i2 (0 n2) is dc=1m mag=1
r2 (n2 0) r r=1k tce=1
i3 (0 n3) is dc=1m mag=1
r3 (n3 0) r r=1k temp=77 tc1=0.01
i4 (0 n4) is dc=1m mag=1
r4 (n4 0) r r=1k dtemp=10 tc1=0.01
i5 (0 n5) is dc=1m mag=1
r5 (n5 0) r r=1k scale=2
i6 (0 n6) is dc=1m mag=1
r6 (n6 0) r r=1k $mfactor=2
i7 (0 c1) is mag=1
rc1 (c1 0) r r=1e12
c1 (c1 0) c c=1n tc1=0.01 tc2=0.001 $mfactor=2
i8 (0 c2) is mag=1
rc2 (c2 0) r r=1e12
c2 (c2 0) c c=1n dtemp=10 tc1=0.01 scale=3
i9 (0 l1) is mag=1
l1 (l1 0) l l=1m tc1=0.01 tc2=0.001 $mfactor=2
i10 (0 l2) is mag=1
l2 (l2 0) l l=1m temp=77 tc1=0.01 scale=3
control
  options temp=50 tnom=27 reltol=1e-9 rawfile="ascii"
  analysis ac1 ac from=1k to=1k mode="lin" points=1
endc
