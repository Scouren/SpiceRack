sin on a grid, folded sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b0 (d0 0) v=sin(-2.5)
r0 (d0 0) r r=1k
b1 (d1 0) v=sin(-1.0)
r1 (d1 0) r r=1k
b2 (d2 0) v=sin(-0.5)
r2 (d2 0) r r=1k
b3 (d3 0) v=sin(-0.0)
r3 (d3 0) r r=1k
b4 (d4 0) v=sin(0.0)
r4 (d4 0) r r=1k
b5 (d5 0) v=sin(0.5)
r5 (d5 0) r r=1k
b6 (d6 0) v=sin(1.0)
r6 (d6 0) r r=1k
b7 (d7 0) v=sin(2.5)
r7 (d7 0) r r=1k
b8 (d8 0) v=sin(1e-3)
r8 (d8 0) r r=1k
b9 (d9 0) v=sin(1e3)
r9 (d9 0) r r=1k
b10 (d10 0) v=sin(-3)
r10 (d10 0) r r=1k
b11 (d11 0) v=sin(0)
r11 (d11 0) r r=1k
b12 (d12 0) v=sin(3)
r12 (d12 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
