ln on a grid, folded sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b187 (d187 0) v=ln(0.5)
r187 (d187 0) r r=1k
b188 (d188 0) v=ln(1.0)
r188 (d188 0) r r=1k
b189 (d189 0) v=ln(2.5)
r189 (d189 0) r r=1k
b190 (d190 0) v=ln(1e-3)
r190 (d190 0) r r=1k
b191 (d191 0) v=ln(1e3)
r191 (d191 0) r r=1k
b194 (d194 0) v=ln(3)
r194 (d194 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
