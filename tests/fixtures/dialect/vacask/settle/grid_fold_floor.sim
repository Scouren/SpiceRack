floor on a grid, folded sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b234 (d234 0) v=floor(-2.5)
r234 (d234 0) r r=1k
b235 (d235 0) v=floor(-1.0)
r235 (d235 0) r r=1k
b236 (d236 0) v=floor(-0.5)
r236 (d236 0) r r=1k
b237 (d237 0) v=floor(-0.0)
r237 (d237 0) r r=1k
b238 (d238 0) v=floor(0.0)
r238 (d238 0) r r=1k
b239 (d239 0) v=floor(0.5)
r239 (d239 0) r r=1k
b240 (d240 0) v=floor(1.0)
r240 (d240 0) r r=1k
b241 (d241 0) v=floor(2.5)
r241 (d241 0) r r=1k
b242 (d242 0) v=floor(1e-3)
r242 (d242 0) r r=1k
b243 (d243 0) v=floor(1e3)
r243 (d243 0) r r=1k
b244 (d244 0) v=floor(-3)
r244 (d244 0) r r=1k
b245 (d245 0) v=floor(0)
r245 (d245 0) r r=1k
b246 (d246 0) v=floor(3)
r246 (d246 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
