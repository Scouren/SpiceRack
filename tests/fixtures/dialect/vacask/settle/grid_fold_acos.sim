acos on a grid, folded sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b53 (d53 0) v=acos(-1.0)
r53 (d53 0) r r=1k
b54 (d54 0) v=acos(-0.5)
r54 (d54 0) r r=1k
b55 (d55 0) v=acos(-0.0)
r55 (d55 0) r r=1k
b56 (d56 0) v=acos(0.0)
r56 (d56 0) r r=1k
b57 (d57 0) v=acos(0.5)
r57 (d57 0) r r=1k
b58 (d58 0) v=acos(1.0)
r58 (d58 0) r r=1k
b60 (d60 0) v=acos(1e-3)
r60 (d60 0) r r=1k
b63 (d63 0) v=acos(0)
r63 (d63 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
