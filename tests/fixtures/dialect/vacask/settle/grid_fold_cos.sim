cos on a grid, folded sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b13 (d13 0) v=cos(-2.5)
r13 (d13 0) r r=1k
b14 (d14 0) v=cos(-1.0)
r14 (d14 0) r r=1k
b15 (d15 0) v=cos(-0.5)
r15 (d15 0) r r=1k
b16 (d16 0) v=cos(-0.0)
r16 (d16 0) r r=1k
b17 (d17 0) v=cos(0.0)
r17 (d17 0) r r=1k
b18 (d18 0) v=cos(0.5)
r18 (d18 0) r r=1k
b19 (d19 0) v=cos(1.0)
r19 (d19 0) r r=1k
b20 (d20 0) v=cos(2.5)
r20 (d20 0) r r=1k
b21 (d21 0) v=cos(1e-3)
r21 (d21 0) r r=1k
b22 (d22 0) v=cos(1e3)
r22 (d22 0) r r=1k
b23 (d23 0) v=cos(-3)
r23 (d23 0) r r=1k
b24 (d24 0) v=cos(0)
r24 (d24 0) r r=1k
b25 (d25 0) v=cos(3)
r25 (d25 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
