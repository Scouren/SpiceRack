int returning functions
load "spice/resistor.osdi"
model res sp_resistor
r1 (n 0) res r=1
control
  print ("integer", integer(3.0)/2, "int", int(3.0)/2, "floor", floor(3.0)/2, "ceil", ceil(3.0)/2, "round", round(3.0)/2, "abs", abs(3)/2, "min", min(3,5)/2, "minr", min(3.0,5)/2, "sgn", sgn(-3)/2, "tern", (1?3:4.0)/2, "neg", -3/2, "pow", 3**1/2, "mul", (3*1)/2, "cmp", (3>2)/2)
endc
