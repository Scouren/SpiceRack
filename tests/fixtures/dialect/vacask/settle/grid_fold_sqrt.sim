sqrt on a grid, folded sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b211 (d211 0) v=sqrt(-0.0)
r211 (d211 0) r r=1k
b212 (d212 0) v=sqrt(0.0)
r212 (d212 0) r r=1k
b213 (d213 0) v=sqrt(0.5)
r213 (d213 0) r r=1k
b214 (d214 0) v=sqrt(1.0)
r214 (d214 0) r r=1k
b215 (d215 0) v=sqrt(2.5)
r215 (d215 0) r r=1k
b216 (d216 0) v=sqrt(1e-3)
r216 (d216 0) r r=1k
b217 (d217 0) v=sqrt(1e3)
r217 (d217 0) r r=1k
b219 (d219 0) v=sqrt(0)
r219 (d219 0) r r=1k
b220 (d220 0) v=sqrt(3)
r220 (d220 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
