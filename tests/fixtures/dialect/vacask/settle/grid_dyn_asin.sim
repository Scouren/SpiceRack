asin on a grid, behavioural sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b41 (d41 0) v=asin(-0.5*($temp/$temp))
r41 (d41 0) r r=1k
b42 (d42 0) v=asin(-0.0*($temp/$temp))
r42 (d42 0) r r=1k
b43 (d43 0) v=asin(0.0*($temp/$temp))
r43 (d43 0) r r=1k
b44 (d44 0) v=asin(0.5*($temp/$temp))
r44 (d44 0) r r=1k
b47 (d47 0) v=asin(1e-3*($temp/$temp))
r47 (d47 0) r r=1k
b50 (d50 0) v=asin(0*($temp/$temp))
r50 (d50 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
