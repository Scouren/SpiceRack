sinh on a grid, behavioural sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b78 (d78 0) v=sinh(-2.5*($temp/$temp))
r78 (d78 0) r r=1k
b79 (d79 0) v=sinh(-1.0*($temp/$temp))
r79 (d79 0) r r=1k
b80 (d80 0) v=sinh(-0.5*($temp/$temp))
r80 (d80 0) r r=1k
b81 (d81 0) v=sinh(-0.0*($temp/$temp))
r81 (d81 0) r r=1k
b82 (d82 0) v=sinh(0.0*($temp/$temp))
r82 (d82 0) r r=1k
b83 (d83 0) v=sinh(0.5*($temp/$temp))
r83 (d83 0) r r=1k
b84 (d84 0) v=sinh(1.0*($temp/$temp))
r84 (d84 0) r r=1k
b85 (d85 0) v=sinh(2.5*($temp/$temp))
r85 (d85 0) r r=1k
b86 (d86 0) v=sinh(1e-3*($temp/$temp))
r86 (d86 0) r r=1k
b88 (d88 0) v=sinh(-3*($temp/$temp))
r88 (d88 0) r r=1k
b89 (d89 0) v=sinh(0*($temp/$temp))
r89 (d89 0) r r=1k
b90 (d90 0) v=sinh(3*($temp/$temp))
r90 (d90 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
