acos on a grid, behavioural sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b54 (d54 0) v=acos(-0.5*($temp/$temp))
r54 (d54 0) r r=1k
b55 (d55 0) v=acos(-0.0*($temp/$temp))
r55 (d55 0) r r=1k
b56 (d56 0) v=acos(0.0*($temp/$temp))
r56 (d56 0) r r=1k
b57 (d57 0) v=acos(0.5*($temp/$temp))
r57 (d57 0) r r=1k
b60 (d60 0) v=acos(1e-3*($temp/$temp))
r60 (d60 0) r r=1k
b63 (d63 0) v=acos(0*($temp/$temp))
r63 (d63 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
