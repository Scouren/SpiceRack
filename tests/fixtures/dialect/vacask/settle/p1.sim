pulse fall zero
load "spice/resistor.osdi"
model res sp_resistor
model vsource vsource
v1 (a 0) vsource type="pulse" val0=0 val1=1 delay=0 rise=1u fall=0 width=1u period=4u
r1 (a 0) res r=1k
v2 (b 0) vsource type="pulse" val0=0 val1=1 delay=0 rise=1u fall=1u width=1u period=4u
r2 (b 0) res r=1k
control
  options rawfile="ascii"
  analysis tr tran stop=10u step=10n maxstep=10n
endc
