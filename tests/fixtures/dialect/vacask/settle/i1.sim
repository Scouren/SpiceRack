integer arithmetic
load "spice/resistor.osdi"
model res sp_resistor
parameters a=1 b=3 c=1.0
r1 (n 0) res r=(1/3)*30+10
r2 (n 0) res r=(a/b)*30+10
r3 (n 0) res r=(c/b)*30+10
r4 (n 0) res r=(-7/2)+10
r5 (n 0) res r=(1/3.0)*30+10
r6 (n 0) res r=(2**-1)*30+10
r7 (n 0) res r=(1k/3)+10
r8 (n 0) res r=(1e3/3)+10
control
  print instance("r1","r2","r3","r4","r5","r6","r7","r8")
endc
