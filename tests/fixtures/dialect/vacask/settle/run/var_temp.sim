tran stop from a var of temp
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
model res sp_resistor
model cap sp_capacitor
model vsource vsource
v1 (a 0) vsource dc=1 mag=1
r1 (a b) res r=1k
c1 (b 0) cap c=1u
parameters k=2
control
  options rawfile="ascii"
  var t=$temp
  analysis p2 tran stop=1m*t/27 maxstep=10u
endc
