tran stop from a swept top parameter
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
model res sp_resistor
model cap sp_capacitor
model vsource vsource
v1 (a 0) vsource dc=1 mag=1
r1 (a b) res r=1k
c1 (b 0) cap c=1u
parameters k=1
control
  options rawfile="ascii"
  sweep sk instance="__topinst__" parameter="k" values=[1, 2]
    analysis p1 tran stop=1m*k maxstep=10u
endc
