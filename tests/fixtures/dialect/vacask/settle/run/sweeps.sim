sweeps and loops
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
load "spice/inductor.osdi"
model res sp_resistor
model cap sp_capacitor
model ind sp_inductor
model vsource vsource
v1 (a 0) vsource dc=1 mag=1
r1 (a b) res r=1k
r2 (b 0) res r=1k
c1 (b 0) cap c=1u
control
  options rawfile="ascii"
  sweep s1 instance="r1" parameter="r" values=[1k, 2k]
    analysis t1 tran stop=1m
  sweep s2 option="temp" values=[0, 50]
  sweep s3 instance="v1" parameter="mag" from=1 to=2 mode="lin" points=1
    analysis a1 ac values=[1k]
  analysis op1 op
  mc m1 samples=2 seed=1
    analysis op2 op nodeset={"b", 0.5}
  endmc
endc
