a sweep binds the next analysis
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
load "spice/inductor.osdi"
model res sp_resistor
model cap sp_capacitor
model ind sp_inductor
model vsource vsource
v1 (a 0) vsource dc=1
r1 (a 0) res r=1k
control
  sweep s instance="v1" parameter="dc" values=[2, 3]
  options reltol=1e-4
  analysis op1 op
endc
