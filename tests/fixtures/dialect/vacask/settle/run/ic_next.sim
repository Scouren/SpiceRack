ic next only
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
load "spice/inductor.osdi"
model res sp_resistor
model cap sp_capacitor
model ind sp_inductor
model vsource vsource
v1 (a 0) vsource dc=0
r1 (a b) res r=1k
c1 (b 0) cap c=1u
control
  options rawfile="ascii"
  analysis t1 tran stop=1m step=1u icmode="uic" ic={"b", 1}
  analysis t2 tran stop=1m step=1u icmode="uic"
endc
