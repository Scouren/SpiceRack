atan on a grid, behavioural sources
load "resistor.osdi"
model r resistor
model vsource vsource
vone (one 0) vsource dc=1
b65 (d65 0) v=atan(-2.5*($temp/$temp))
r65 (d65 0) r r=1k
b66 (d66 0) v=atan(-1.0*($temp/$temp))
r66 (d66 0) r r=1k
b67 (d67 0) v=atan(-0.5*($temp/$temp))
r67 (d67 0) r r=1k
b68 (d68 0) v=atan(-0.0*($temp/$temp))
r68 (d68 0) r r=1k
b69 (d69 0) v=atan(0.0*($temp/$temp))
r69 (d69 0) r r=1k
b70 (d70 0) v=atan(0.5*($temp/$temp))
r70 (d70 0) r r=1k
b71 (d71 0) v=atan(1.0*($temp/$temp))
r71 (d71 0) r r=1k
b72 (d72 0) v=atan(2.5*($temp/$temp))
r72 (d72 0) r r=1k
b73 (d73 0) v=atan(1e-3*($temp/$temp))
r73 (d73 0) r r=1k
b74 (d74 0) v=atan(1e3*($temp/$temp))
r74 (d74 0) r r=1k
b75 (d75 0) v=atan(-3*($temp/$temp))
r75 (d75 0) r r=1k
b76 (d76 0) v=atan(0*($temp/$temp))
r76 (d76 0) r r=1k
b77 (d77 0) v=atan(3*($temp/$temp))
r77 (d77 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
