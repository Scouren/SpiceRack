atan2 forms in behavioural sources
load "resistor.osdi"
model r resistor
model vsource vsource
parameters p=0.5 q=-0.5
vone (one 0) vsource dc=1
b0 (d0 0) v=atan2(p, q)
b1 (d1 0) v=atan2(0.5*v(one), q)
b2 (d2 0) v=atan2(0.5, -0.5)
b3 (d3 0) v=atan2(0.5+$temp*0, -0.5)
b4 (d4 0) v=atan2(0.5*v(one), -0.5*v(one))
b5 (d5 0) v=sin(p)+atan2(0.5, -0.5)
r0 (d0 0) r r=1k
r1 (d1 0) r r=1k
r2 (d2 0) r r=1k
r3 (d3 0) r r=1k
r4 (d4 0) r r=1k
r5 (d5 0) r r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
