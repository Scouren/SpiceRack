# oracle: tables.rs levels (xpressn.c fetchoperator, inpptree-parser.y); the fewest parentheses that read back as the same tree
file "expr_parens.sp" deck
  title "expr_parens"
  param a = pow_abs(2, pow_abs(3, 2))
  param b = (-2) * 3
  param c = -(2)
  param d = 1 - (2 - 3)
  param e = 1 ? (0 ? 4 : 8) : 16
  param f = (0 == 1) < 2
  param g = 0 == (1 < 2)
  param h = !(a + b)
  param i = 3 * -2
