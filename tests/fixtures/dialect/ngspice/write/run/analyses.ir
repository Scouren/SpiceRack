# oracle: ngspice-45 inp2dot.c (each card's positional form), traninit.c:29 (the ngspice cap is the default ceiling); written by hand
file "analyses.sp" deck
  title "analyses"
  element vsource v1 (a 0) dc=1
  param tstop = 2u
  analysis op
  analysis dc (source_dc v1) (lin start=-1 stop=1 step=0.5) (temp) (lin start=0 stop=50 step=25) afresh
  analysis ac (lin start=0 stop=1k points=11)
  analysis tran stop=(tstop * 2) print_step=1n max_step=10n uic
  analysis pz nodes current zeros in_p=in in_n=0 out_p=out out_n=0
  analysis disto (dec start=1k stop=10k points=5) f2_over_f1=0.9
  analysis sp (lin start=1 stop=10 points=2) noise
  analysis pss autonomous uic fundamental=1k tstab=1m harmonics=10 points=64 osc_p=b osc_n=0 sc_iter=50 steady_coeff=1e-3
