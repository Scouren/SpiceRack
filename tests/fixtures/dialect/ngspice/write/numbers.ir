# oracle: inpeval.c and xpressn.c parseunit (ngspice's scale letters t g meg k m u n p f a; a centi or peta scale, and mil in numparam where it reads as milli, are respelled exactly in exponent form: R28)
file "numbers.sp" deck
  title "numbers"
  param a = 100u
  param b = 0.050000
  param c = 1meg
  param d = 1.5e-3
  param e = 3c
  param f = 2mil
