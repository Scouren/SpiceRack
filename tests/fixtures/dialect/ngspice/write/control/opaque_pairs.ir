# oracle: lead's Q7: inert commands are .control pairs, adjacent pairs joined, closed before a deck line (S3-CONTROL O1); written by hand
file "opaque_pairs.sp" deck
  title "opaque_pairs"
  opaque ngspice inert ".control\necho a\n.endc"
  opaque ngspice inert ".control\necho b\n.endc"
  analysis op
  opaque ngspice inert ".control\necho c\n.endc"
