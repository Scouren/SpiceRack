# codes: P1006
file "param_temp_class.sp" deck
  title "param_temp_class"
  comment " oracle: R14 (a parameter reading temper, directly or through another, is the B-source parser's: inpcom.c inp_fix_temper_in_param), inpptree-parser.y (< binds tighter than ==), xpressn.c (numparam: one level)"
  param t = $temp
  param q = t == (1 < 2)
  opaque ngspice invalid ".if (t)\n.endif"
