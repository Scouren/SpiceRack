# codes: P1305 P1305
file "temp_options.sp" deck
  title "temp_options"
  comment " oracle: ngspice-45 cktsopt.c:268-269 (temp, tnom options), inp.c:1159-1186 (.temp beats .options temp= in either order); runs temp1.cir, temp2.cir (85 over 50), .options tnom=85"
  opaque ngspice inert ".options temp=50"
  option rel_tol value=1e-3 whole_run
  env tnom=40 whole_run
  opaque ngspice inert ".options temp=50"
  env temp=85 whole_run
