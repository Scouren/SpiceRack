file "level_invalid.sp" deck
  title "level_invalid"
  comment " oracle: inpfindl.c (a level above 99 or below 0 runs level 1: run level=100 prints Level must be < 99 (Setting Level to 1)), inpdomod.c (MOS 7 and 15 not in this binary, BJT 3, JFET 3, MES 7: no device), runs: level=7, 15 could not find a valid modelname"
  opaque ngspice invalid ".model a nmos level=100 vto=0.5"
  opaque ngspice invalid ".model b nmos level=7"
  opaque ngspice invalid ".model c pmos level=15"
  opaque ngspice invalid ".model d nmos level=-2"
  opaque ngspice invalid ".model e npn level=3"
  opaque ngspice invalid ".model f njf level=3"
  opaque ngspice invalid ".model g nmf level=7"
