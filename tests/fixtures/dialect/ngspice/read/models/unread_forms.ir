# codes: P1203 P1203 P1203 P1203 P1203 P1203 P1203 P1203
file "unread_forms.sp" deck
  title "unread_forms"
  comment " oracle: inpdomod.c (MESA levels 2-4: no IR family), INPfindLev (a level in braces is numparam's before the card is read), inptyplk.c (a device name as type word), inpcompat.c:282 (ako: only in PSPICE mode), create_model (a bare flag), manual 2.15 (a model in an .if branch)"
  opaque ngspice unread ".model ma nmf level=2"
  opaque ngspice unread ".model mb nmos level={lv}"
  opaque ngspice unread ".model mc bsim4 level=54"
  opaque ngspice unread ".model md ako:mm nmos"
  opaque ngspice unread ".model me nmos level=1 pmos"
  opaque ngspice unread ".model mf cpl r=0.1 0 0.1"
  opaque ngspice unread ".model mg nmos vto={temper}"
  if (1)
    opaque ngspice unread ".model mh d"
