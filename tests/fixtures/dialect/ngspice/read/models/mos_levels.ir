# codes:
file "mos_levels.sp" deck
  title "mos_levels"
  comment " oracle: inpdomod.c nmos/pmos switch (levels 0 and 1 Mos1, 2, 3, 4 BSIM1, 5 BSIM2, 6, 9, 8 and 49 BSIM3), inpfindl.c (level is (int)(value+0.5): 4.9e1 is 49, -1 is 0), b3set.c:84 (a silent BSIM3 version is 3.3.0), run: level=-1 runs level 1"
  model m1 mos1 polarity=n params=(vto=0.5 kp=1e-4)
  model m0 mos1 polarity=n params=(vto=0.5)
  model mn mos1 polarity=p
  model m2 mos2 polarity=p params=(vto=-0.5)
  model m3 mos3 polarity=n params=(theta=0.1)
  model m6 mos6 polarity=n
  model m9 mos9 polarity=p
  model b1 bsim1 polarity=n
  model b2 bsim2 polarity=n
  model b3 bsim3 polarity=n version="3.3.0"
  model b3s bsim3 polarity=n version="3.2.4"
