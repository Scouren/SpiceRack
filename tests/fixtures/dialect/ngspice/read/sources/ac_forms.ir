laws bc_sat_area_times_areab sub_sat_last_factor diode_wl_mult_twice diode_sidewall_bottom_f1 diode_xom_absent_1e4 vdmos_kp_absent_35 vdmos_tcvth_lowers vdmos_clamp_by_n mos_small_signal_hand mos6_small_signal_absent bjt_irb_small_signal_frozen vdmos_mult_charges_off diode_isr_reverse_none diode_isr_small_signal_hand diode_tt_factor_unclamped trig_reduce_cast exp_clamp_1e99 log_zero_minus_1e99 div_gmin_guard asin_edge_zero default_temp_27 default_tnom_27 bsim4v45_small_signal_hand
# codes: P1157 P1157 P1157 P1157 P1406
file "ac_forms.sp" deck
  title "ac_forms"
  comment " oracle: vsrctemp.c (ac with no magnitude is 1, no phase 0), vsrc.c (acmag, acphase), run: ac lin 1 1 1 gives 1, 2/90 deg, 3, and m 3 times ac 1 45 on the I card"
  element vsource V1 (a 0) dc=0 ac_mag=1 ac_phase_deg=0
  element vsource V2 (b 0) dc=1 ac_mag=2 ac_phase_deg=0
  element vsource V3 (c 0) dc=0 ac_mag=2 ac_phase_deg=45
  element vsource V4 (d 0) dc=0 ac_mag=2 ac_phase_deg=90
  element vsource V5 (e 0) dc=0 ac_mag=1 ac_phase_deg=30
  element isource I6 (f 0) mult=3 dc=2 ac_mag=1 ac_phase_deg=45
  element resistor R6 (f 0) value=1
  analysis ac (lin start=1 stop=1 points=1)
  opaque ngspice inert ".control\nprint v(a) v(b) v(c) v(d) v(e) v(f)\n.endc"
