# codes:
file "meas_param.sp" deck
  title "meas_param"
  comment " oracle: ngspice-45 measure.c do_measure (every other measure first, its result a numparam parameter; then param= by nupa_eval); runs: p1 = 2*tr, p3 reads the later measure 'later'"
  param k = 2
  measure tr tran when (cross cross skip_initial (v (a)) value=0.5)
  measure p1 tran param value=(tr * k)
  measure p2 tran param value=(later + 1)
  measure later tran stat max (v (a)) (bound) (bound)
