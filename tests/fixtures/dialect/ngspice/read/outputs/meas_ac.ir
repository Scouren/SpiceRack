# codes:
file "meas_ac.sp" deck
  title "meas_ac"
  comment " oracle: ngspice-45 com_measure2.c correct_vec, get_value (ac: v() is the real part, vm magnitude, vp phase in degrees, vdb dB, vr real)"
  measure g ac find (v re (out)) (at value=1k)
  measure gm ac stat max (v db (out)) (bound) (bound)
  measure ph ac find (v phase_deg (out)) (at value=1k)
  measure bw ac when (cross fall (v db (out)) value=-3 count=1)
  measure m ac find (v mag (out)) (cross cross (v re (out)) value=0.5 count=1)
