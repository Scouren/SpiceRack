# codes:
file "meas_ac.sp" deck
  title "meas_ac"
  comment " oracle: ngspice-45 com_measure2.c correct_vec, get_value (ac: v() is the real part, vm magnitude, vp the phase in radians (radtodeg converts only under units=degrees; run: ph = -5.609821e-01 at 100 Hz, the printed vp), vdb dB, vr real; from= skips frequencies below it, td= is ignored off tran); run: when vdb(out)=-3 from=200 fails 'out of interval', td=200 gives 158.78"
  measure g ac find (v re (out)) (at value=1k)
  measure gm ac stat max (v db (out)) (bound) (bound)
  measure ph ac find (v phase_rad (out)) (at value=1k)
  measure bw ac when (cross fall (v db (out)) value=-3 count=1)
  measure m ac find (v mag (out)) (cross cross skip_initial (v re (out)) value=0.5)
  measure b2 ac when (cross cross skip_initial (v db (out)) value=-3 delay=200)
