file "meas_invalid.sp" deck
  title "meas_invalid"
  comment " oracle: ngspice-45 get_measure2 (deriv, err: 'currently not supported'; integral: 'no such function'), do_measure (op: 'unrecognized analysis type'; three words: 'incomplete measurement statement'), measure_parse_when ('Expressions like v(b)*2 are not supported'); runs: find v(a,b) 'no such vector', td=<measure> 'Undefined parameter' (fatal), when v(a)=0.2*2 'Expressions like 0.2*2 are not supported', param='fval+7' 'Undefined parameter [fval]'; at=2 m 'equal sign missing'; v() no such vector"
  opaque ngspice invalid ".meas tran d1 deriv v(a) at=1u"
  opaque ngspice invalid ".meas tran d2 find v(a,b) at=1u"
  opaque ngspice invalid ".meas tran d3 integral v(a)"
  opaque ngspice invalid ".meas op d4 find v(a) at=1"
  measure w tran when (cross cross skip_initial (v (a)) value=0.5)
  opaque ngspice invalid ".meas tran d5 when v(a)=0.5 td=w"
  opaque ngspice invalid ".meas tran d6 err v(a)"
  opaque ngspice invalid ".meas tran d7 when v(a)=v(b)*2"
  opaque ngspice invalid ".meas tran d8"
  opaque ngspice invalid ".meas tran d9 when v(a)=0.2*2"
  opaque ngspice invalid ".meas tran d10 when v(a)=0.4xyz"
  opaque ngspice invalid ".meas tran d11 param='fval+7'"
  opaque ngspice invalid ".meas tran d12 find v(a) at=2 m"
  opaque ngspice invalid ".meas tran d13 rms v()"
