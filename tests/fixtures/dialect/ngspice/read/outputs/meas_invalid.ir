# codes: P1351 P1351 P1351 P1351 P1351 P1351 P1351 P1351
file "meas_invalid.sp" deck
  title "meas_invalid"
  comment " oracle: ngspice-45 get_measure2 (deriv, err: 'currently not supported'; integral: 'no such function'), do_measure (op: 'unrecognized analysis type'; three words: 'incomplete measurement statement'), measure_parse_when ('Expressions like v(b)*2 are not supported'); runs: find v(a,b) 'no such vector', td=<measure> 'Undefined parameter' (fatal)"
  opaque ngspice invalid ".meas tran d1 deriv v(a) at=1u"
  opaque ngspice invalid ".meas tran d2 find v(a,b) at=1u"
  opaque ngspice invalid ".meas tran d3 integral v(a)"
  opaque ngspice invalid ".meas op d4 find v(a) at=1"
  measure w tran when (cross cross (v (a)) value=0.5 count=1)
  opaque ngspice invalid ".meas tran d5 when v(a)=0.5 td=w"
  opaque ngspice invalid ".meas tran d6 err v(a)"
  opaque ngspice invalid ".meas tran d7 when v(a)=v(b)*2"
  opaque ngspice invalid ".meas tran d8"
