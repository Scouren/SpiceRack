# codes: P1101
file "controlled.sp" deck
  title "controlled"
  comment " oracle: ngspice-45 inp2e.c..inp2h.c, inpcom.c inp_compat (vcvs word, value=/vol=/cur= to B, table to XSPICE pwl input_domain=0.1), inp_poly_2g6_compat; run f5; settle table_brace_point.sp (a braced point is numparam's number, the IR's expression point is no writer's: Unread, R74 (4))"
  param k = 3
  element vcvs E1 (o 0 c 0) gain=2
  element vcvs E2 (o 0 c 0) gain=(k * 2)
  element vccs G1 (o 0 c 0) mult=3 gain=1m
  element cccs F1 (o 0) mult=2 gain=2 sense=vx
  element ccvs H1 (o 0) gain=1k sense=vx
  element poly E3 (o 0) controls=(a 0 b 0) coeffs=[0, 1, 2] dimension=2
  element poly F2 (o 0) controls=(vx) coeffs=[0, 3] dimension=1 output=current control=current
  element poly G2 (o 0) controls=(c 0) coeffs=[1, 2] dimension=1 output=current
  element behav E4 (o 0) expr=(v(c) * 4)
  element behav E5 (o 0) expr=(v(c) * 6)
  element behav G3 (o 0) mult=2 expr=(v(c) / 1k) output=current
  element table E6 (o 0) input=(v(c)) points=[0, 0, 1, 2] law=ngspice_rounded
  opaque ngspice unread "E7 o 0 table {v(c)} = (0,0) ({k},2)"
