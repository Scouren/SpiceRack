  element charge_capacitor C2 (a b) expr=(1p * v(a)) output=charge
  element resistor R3 (a b) value=($temp * 10) noisy=false
  element resistor R4 (a b) value=(v(a) * 1k) tc1=1m noisy=false tc_base=fixed27
  element capacitor C3 (a b) value=(1p * v(a)) tc1=1m tc2=1u noisy=false tc_base=fixed27 tc_law=reciprocal
  element resistor rd2 (d2 d1) mult=nf value=(max(1e-2, (rd * nfet_10v0_asym_drdsw * (1 + trth1 * ($temp + dtemp - 25) + trth2 * ($temp + dtemp - 25) * ($temp + dtemp - 25))) / (w / nf - wb) * (tanh(ra * (v(d, s) - rb * (l - lb) / (0.6e-6 - lb)))))) noisy=false
  element charge_capacitor C4 (a b) expr=(1p * v(a)) tc1=1m output=charge tc_base=fixed27 tc_law=reciprocal
