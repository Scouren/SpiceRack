# codes:
file "bsource.sp" deck
  title "bsource"
  comment " oracle: ngspice-45 inp2b.c, asrc.c (v i temp dtemp m), inpcom.c inp_bsource_compat (the B-source parser reads it); run f5 (B1 c 0 V=1 + 2 tc1=0 is 3 V)"
  element behav B1 (a 0) expr=(1 + 2)
  element behav B2 (b 0) mult=2 expr=(v(a) * 2) output=current
  element behav B3 (c 0) expr=(v(a) * 3) temp_abs=50 dtemp=1
