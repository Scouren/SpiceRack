# codes: P1101
file "names_hash.sp" deck
  title "names_hash"
  comment " oracle: settle/names_hash.sp (ngspice-45 runs it: a card name runs to the first blank, rs#1 and xCMP#1 are names; 2SK170 is a model name; a VDMOS's thermal nodes have no IR field yet, Unread)"
  subckt cmp (a b)
    element resistor R1 (a b) value=2k
  element resistor `rs#1` (a 0) value=1k
  element instance `xCMP#1` (a 0) model=cmp
  element instance `xCMP#2` (a 0) model=cmp
  element jfet JQ1 (a 0 0) model=2SK170
  model 2SK170 jfet_shichman polarity=n
  opaque ngspice unread "MQ5 a a 0 tj tc IRFP240 thermal"
  model IRFP240 vdmos polarity=n
