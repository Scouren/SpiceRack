# codes: P1109 P1109
file "wrapped.sp" deck
  title "wrapped"
  comment " oracle: settle/wrap_element_{1,2,3,4}.sp ({a}+{b} and 'a'+'b': 'unknown parameter (+)', each wrapper its own expression; 'a+{b}' and {a+'b'}: R = 3, a wrapper inside the other is a parenthesis)"
  param a = 1
  param b = 2
  opaque ngspice invalid "R1 n 0 {a}+{b}"
  opaque ngspice invalid "R2 n 0 'a'+'b'"
  element resistor R3 (n 0) value=(a + b)
  element resistor R4 (n 0) value=(a + b)
