# codes: P1106
file "osdi_codemodel.sp" deck
  title "osdi_codemodel"
  comment " oracle: ngspice-45 inp2n.c (OSDI: nodes, model, the module's parameters; m= the multiplicity, settle osdi_mult.sp); ngspice manual ch.12 (XSPICE A lines, port modifiers)"
