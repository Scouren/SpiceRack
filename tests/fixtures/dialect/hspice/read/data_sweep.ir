# codes:
file "data_sweep.sp" deck
  title "data_sweep"
  comment " settle (ESPice 0.3.0, --tokenizer=hspice; ESPice is not HSPICE): two plots, rr=1000: -1e-3, rr=4000: -2.5e-4: '.dc … sweep data=tab'"
  param rr = 1k
  element vsource v1 (1 0) dc=1
  element resistor r1 (1 0) value=rr
  loop table name=tab (param rr) values=[1k, 4k]
    analysis dc (source_dc v1) (lin start=1 stop=1 step=1)
