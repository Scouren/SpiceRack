# codes:
file "expr_random.sp" deck
  title "expr_random"
  comment " settle (ESPice 0.3.0, --tokenizer=hspice; ESPice is not HSPICE): agauss, gauss, aunif, unif, limit(1,0.5) all 1 (the nominal) outside Monte Carlo"
  element vsource vs (s 0) dc=1
  element vsource ve0 (e0 0) dc=(draw:abs_gauss:sampling:reference(1, 0.1, 3))
  element vsource ve1 (e1 0) dc=(draw:rel_gauss:sampling:reference(1, 0.1, 3))
  element vsource ve2 (e2 0) dc=(draw:abs_unif:sampling:reference(1, 0.5))
  element vsource ve3 (e3 0) dc=(draw:rel_unif:sampling:reference(1, 0.5))
  element vsource ve4 (e4 0) dc=(draw:limit:sampling:reference(1, 0.5))
  analysis dc (source_dc vs) (lin start=1 stop=1 step=1)
