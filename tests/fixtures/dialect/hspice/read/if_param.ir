# codes:
laws diode_wl_mult_once vdmos_tcvth_lowers mos_small_signal_exact mos6_small_signal_exact diode_isr_reverse_none diode_isr_small_signal_exact trig_exact log_zero_error div_exact default_temp_25 default_tnom_25
file "if_param.sp" deck
  title "if_param"
  comment " settle (ESPice 0.3.0, --tokenizer=hspice; ESPice is not HSPICE): i(v1) = -1e-3: .if (sel==1) chooses .param r=1k"
  param sel = 1
  if (sel == 1)
    param r = 1k
  else
    param r = 2k
  element vsource v1 (1 0) dc=1
  element resistor r1 (1 0) value=r
  analysis dc (source_dc v1) (lin start=1 stop=1 step=1)
