# codes:
laws diode_wl_mult_once vdmos_tcvth_lowers mos_small_signal_exact mos6_small_signal_exact diode_isr_reverse_none diode_isr_small_signal_exact trig_exact log_zero_error div_exact default_temp_25 default_tnom_25
file "param_string.sp" deck
  title "param_string"
  comment " settle (ESPice 0.3.0, --tokenizer=hspice; ESPice is not HSPICE): t2 = 8: .param t2=\"a^3\" is an expression, not a string"
  param a = 2
  param t2 = pow(a, 3)
  element vsource vs (s 0) dc=1
  element vsource ve0 (e0 0) dc=t2
  analysis dc (source_dc vs) (lin start=1 stop=1 step=1)
