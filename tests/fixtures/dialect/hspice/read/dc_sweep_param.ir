# codes:
file "dc_sweep_param.sp" deck
  title "dc_sweep_param"
  comment " settle (ESPice 0.3.0, --tokenizer=hspice; ESPice is not HSPICE): two plots, rr=1000: -1e-3, rr=2000: -5e-4: '.dc … sweep rr 1k 2k 1k'"
  param rr = 1k
  element vsource v1 (1 0) dc=1
  element resistor r1 (1 0) value=rr
  loop sweep (param rr) (lin start=1k stop=2k step=1k)
    analysis dc (source_dc v1) (lin start=1 stop=1 step=1)
