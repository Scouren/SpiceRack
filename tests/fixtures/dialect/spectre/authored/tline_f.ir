# tests/fixtures/dialect/spectre/authored/tline_f.scs read by the spectre row; checked by hand against the deck and its RUN-SP outcome (the recorded decks: tests/spectre/pending.json, expected.json; an authored deck: its first line).
# codes: S0003 P6008
laws default_temp_27 default_tnom_27
file "tline_f.scs" deck
  title "// a tline given by f, its nl 0.25 when absent (MAN only: no run settled the default)"
  opaque spectre inert "simulator lang=spectre"
  element vsource v1 (in 0) dc=0 ac_mag=1 ac_phase_deg=0
  element lossless_line t1 (in 0 out 0) z0=50 freq=100meg nl=0.25
  element resistor rl (out 0) value=50
  analysis xf name=xf1 (v (out)) (list values=[100meg])
