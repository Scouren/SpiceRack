  element resistor r4 (n2 0) value=1k
  element vcvs e1 (e 0 out 0) gain=2
  element resistor re (e 0) value=1k
  element vccs g1 (0 g out 0) gain=1m
  element resistor rg (g 0) value=1k
  element cccs f1 (0 f) gain=3 sense=v1
  element resistor rf (f 0) value=1
  element ccvs h1 (h 0) gain=100 sense=v1
