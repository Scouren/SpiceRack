# tests/spectre/p_behavioural.scs read by the spectre row; checked by hand against the deck and its RUN-SP outcome (tests/spectre/pending.json, expected.json).
# codes: S0003 P6008
file "p_behavioural.scs" deck
  title "// t"
  opaque spectre inert "simulator lang=spectre"
  element vsource v1 (in 0) dc=2
  element resistor r1 (in out) value=2k
  element resistor r2 (out 0) value=1k
  element behav b1 (b 0) expr=(3 * v(out) * v(out))
  element resistor rb (b 0) value=1k
  analysis op name=op1
