# tests/spectre/t_s2_aunif.scs read by the spectre row; checked by hand against the deck and its RUN-SP outcome (the recorded decks: tests/spectre/pending.json, expected.json; an authored deck: its first line).
# codes: S0003 P6008
laws default_temp_27 default_tnom_27
file "t_s2_aunif.scs" deck
  title "// t_s2_aunif.scs"
  opaque spectre inert "simulator lang=spectre"
  func rack_aunif(nom, avar, u) = nom + avar * u
  param rack_r1_r_1 = 0
  statistics process (rack_r1_r_1 unif spread=1)
  element vsource v1 (in 0) dc=1
  element resistor r1 (in out) value=(@rack_aunif(1k, 100, rack_r1_r_1))
  element resistor r2 (out 0) value=1k
  analysis op name=op1
  loop monte_carlo name=mc1 runs=2000 seed=1 all nominal
    analysis op name=dcmc
