# tests/spectre/t_s3_nested.scs read by the spectre row; checked by hand against the deck and its RUN-SP outcome (tests/spectre/pending.json, expected.json).
# codes: S0003 P6008
file "t_s3_nested.scs" deck
  title "// t_s3_nested.scs"
  opaque spectre inert "simulator lang=spectre"
  func rack_agauss(nom, avar, sigma, z) = nom + (avar > 0 && sigma > 0 ? avar : 0) / (sigma > 0 ? sigma : 1) * z
  param rack_leaf_rl_1 = 0
  statistics mismatch (rack_leaf_rl_1 gauss spread=1)
  subckt leaf (a b) rl=(@rack_agauss(1k, 100, 1, rack_leaf_rl_1))
    element resistor r1 (a b) value=rl
    element resistor r2 (b 0) value=1k
  subckt two (a b c)
    element instance xa (a b) model=leaf
    element instance xb (a c) model=leaf
  element vsource v1 (in 0) dc=1
  element instance x1 (in o1 o2) model=two
  element instance x2 (in o3 o4) model=two
  analysis op name=op1
  loop monte_carlo name=mc1 runs=2000 seed=1 mismatch nominal
    analysis op name=dcmc
