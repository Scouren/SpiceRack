# tests/spectre/t_s2_agauss.scs read by the spectre row; checked by hand against the deck and its RUN-SP outcome (tests/spectre/pending.json, expected.json).
# codes: S0003 P6008
file "t_s2_agauss.scs" deck
  title "// t_s2_agauss.scs"
  opaque spectre inert "simulator lang=spectre"
  func rack_agauss(nom, avar, sigma, z) = nom + (avar > 0 && sigma > 0 ? avar : 0) / (sigma > 0 ? sigma : 1) * z
  param rack_r1_r_1 = 0
  statistics process (rack_r1_r_1 gauss spread=1)
  element vsource v1 (in 0) dc=1
  element resistor r1 (in out) value=(@rack_agauss(1k, 100, 3, rack_r1_r_1))
  element resistor r2 (out 0) value=1k
  analysis op name=op1
  loop monte_carlo name=mc1 runs=2000 seed=1 all nominal
    analysis op name=dcmc
